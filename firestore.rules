rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{document} {
      allow read: if true;
      allow create: if true;
      // Admins can change anything. A registrant may only mark that they
      // opened the WhatsApp chat (click proof for the dashboard).
      allow update: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2'
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['whatsappOpened', 'whatsappOpenedAt', 'whatsappStatus', 'whatsappCheckedAt']);
      allow delete: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }

    // Guest WiFi sessions (guest-access-portal).
    // Guests may create exactly one immutable 45-minute session per phone
    // per day. durationMinutes is pinned to 45 and expiresAt must equal
    // startTime + 45m, so a client cannot hand itself a longer session.
    // No updates or deletes: a guest cannot extend or reset their session.
    match /wifi_sessions/{document} {
      allow read: if true;
      allow create: if request.resource.data.durationMinutes == 45
                    && request.resource.data.durationMinutes is int
                    && request.resource.data.phone is string
                    && request.resource.data.date is string
                    && request.resource.data.expiresAt
                       == request.resource.data.startTime + duration.value(45, 'm');
      allow update, delete: if false;
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }
  }
}